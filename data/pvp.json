  "mvp": { "_note": "WP363 (임시): 대련 MVP(내 팀 1명, 승패 무관) — 점수 = 준 피해 + 회복 + 보호막 + 처치 1회당 상대 최대 HP killPctOfMaxHp%, 동점 = 살아남은 쪽 → 팀 순서. 진짜 대련만 특전(연습·방어 다시 보기 X): 경험치 ×expMult · 기력 최대치 staminaPctOfMax% 즉시 · 숙소에서 lodgeHours시간 동안 말풍선 lodgeShare 비율로 MVP 자랑(다음 진짜 대련에서 다른 사람이 MVP면 끝)", "killPctOfMaxHp": 20, "expMult": 1.5, "staminaPctOfMax": 30, "lodgeHours": 3, "lodgeShare": 0.5 },
  "analysis": { "_note": "WP364 (임시): 대련 결과 [분석] — 상대 전투력 ≥ 내 ×tooStrongRatio: 짐 = 버거웠어요(위로), 이김 = 작전 칭찬 / 내가 ×tooStrongRatio 이상인데 짐 = 방심. 조언 = rules(lost·won·upset) 순서대로 조건이 맞는 앞 2개 — frontEarly 앞줄이 earlyDownSec초 안에 쓰러짐 · noHeal 회복+보호막 0 · focus 상대 피해의 focusPct% 이상이 한 명에게 · carry 내 피해의 carryPct% 이상이 한 명 · gear 장비 강화 · mvp MVP 활약 · lateDown 첫 쓰러짐이 늦음(없음) · support 회복+보호막 · next 다음 단계", "tooStrongRatio": 1.3, "earlyDownSec": 10, "carryPct": 70, "focusPct": 60, "_note410": "WP410 (임시): 이긴 판 = 내 남은 체력%(로그로 계산) — crushHpPct% 이상·쓰러진 동료 1명 이하 = 압승(rules.crush, next는 여기만) / closeHpPct% 이하 또는 1명 남고 closeLastHpPct% 이하 = 근소승(rules.close: danger 누가 몇 초에 쓰러지고 몇 초 버텼나) / 그 외 won. 진 판 상대 남은 체력 closeHpPct% 이하 = 아깝게. 새 조언: turn 첫 쓰러짐 뒤 우리 초당 딜 dropPct% 이상 감소(앞뒤 turnMinSec초 이상) · ranged 상대 뒷줄 궁수가 상대 딜 rangedPct% 이상(우리가 그에게 준 피해 25% 미만) → 정찰 동료 · fxHurt 상대 화상·출혈·불벼락 피해 fxPct% 이상 → 보호막·흡혈 · slow longSec초 이상 끌고 우리 딜 부족 → 주력 딜러 무기. 기준: 동급 600판 sim에서 이긴 쪽 남은 체력 중앙값 마니아 33%·로열 9%", "crushHpPct": 40, "closeHpPct": 15, "closeLastHpPct": 25, "dropPct": 30, "turnMinSec": 3, "rangedPct": 35, "fxPct": 20, "longSec": 24, "rules": { "lost": ["turn", "frontEarly", "ranged", "fxHurt", "focus", "slow", "noHeal", "carry", "gear"], "won": ["mvp", "turn", "fxHurt", "ranged", "carry", "support"], "upset": ["mvp", "lateDown", "support"], "crush": ["mvp", "next"], "close": ["danger", "turn", "focus", "fxHurt", "ranged", "frontEarly", "slow"] } },
